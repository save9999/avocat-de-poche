# ─── LLM + embeddings (Google Gemini, free tier) ─────────────────────────────
# Clé gratuite : https://aistudio.google.com/apikey
# REQUIS — sans elle, le chat passe en mode dégradé « sources officielles ».
GEMINI_API_KEY=AIzaXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Chaîne de modèles de repli, du plus au moins prioritaire (optionnel).
# Défaut : gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash,gemini-2.0-flash-lite
# GEMINI_CHAT_MODEL=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash,gemini-2.0-flash-lite

# ─── Base juridique (Neon Postgres + pgvector) ───────────────────────────────
# Projet gratuit : https://neon.tech — puis provisionner le schéma :
#   psql "$DATABASE_URL" -f migrations/0001_schema.sql
# REQUIS pour le RAG et les pages /droits.
DATABASE_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ─── Rate limiting (optionnel) ───────────────────────────────────────────────
# Upstash Redis (free tier) : compteur partagé entre réplicas Vercel.
# Sans ces variables, fallback in-memory par réplique (suffisant en dev).
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=AXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Limites par IP (optionnel). Défaut : 20 requêtes / 3600 s.
# RATE_LIMIT_MAX_REQUESTS=20
# RATE_LIMIT_WINDOW_SECONDS=3600

# ─── Ingestion (scripts, optionnel) ──────────────────────────────────────────
# Budget de tokens par sous-lot d'embeddings et pause entre sous-lots — réglés
# pour rester sous les quotas free tier Gemini (cf. lib/embeddings.ts).
# EMBED_TOKEN_BUDGET=15000
# EMBED_SUBBATCH_PAUSE_MS=1100
